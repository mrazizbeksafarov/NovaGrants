# Bu faylni .env deb nusxalab, o'z qiymatlaringizni yozing.
# .env HECH QACHON GitHub'ga yuklanmaydi (.gitignore da).
# GitHub Actions uchun bu qiymatlar Settings → Secrets and variables → Actions da saqlanadi.

# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Kanal manzili (@nomi) yoki raqamli ID (-100...)
TELEGRAM_CHANNEL_ID="@your_channel_username"

# Nosozlik bildirishnomasi uchun (ixtiyoriy, lekin tavsiya etiladi).
# Yurish oxirida muammo topilsa shu ID ga shaxsiy xabar keladi:
# havola topish darajasi pasaysa, aggregator sizib chiqsa yoki post chiqmasa.
# O'z ID ingizni @userinfobot dan oling. Bo'sh qoldirilsa — jimgina o'tkaziladi.
ADMIN_ID="your_admin_id"

# https://aistudio.google.com/apikey dan olinadi
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: comma-separated keys (never commit real keys).
GEMINI_API_KEYS=""
# Daily editorial requests use medium thinking by default.
GEMINI_THINKING_LEVEL="medium"
AI_TIMEOUT_SECONDS="240"
# Measured on a small eligibility smoke test; models can be reordered here.
GEMINI_MODELS="gemini-3.6-flash,gemini-3.5-flash"

# Groq selects official links and backs up editorial requests after Gemini failure.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Supabase → Project Settings → API
SUPABASE_URL="your_supabase_project_url_here"
# Backend credential only. Review table access/RLS before switching an existing key.
SUPABASE_KEY="your_supabase_backend_key_here"
