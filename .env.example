# Bu faylni .env deb nusxalab, o'z qiymatlaringizni yozing.
# .env HECH QACHON GitHub'ga yuklanmaydi (.gitignore da).
# GitHub Actions uchun bu qiymatlar Settings → Secrets and variables → Actions da saqlanadi.

# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Kanal manzili (@nomi) yoki raqamli ID (-100...)
TELEGRAM_CHANNEL_ID="@your_channel_username"

# Nosozlik bildirishnomasi uchun (ixtiyoriy, lekin tavsiya etiladi).
# Yurish oxirida muammo topilsa shu ID ga shaxsiy xabar keladi:
# havola topish darajasi pasaysa, aggregator sizib chiqsa yoki post chiqmasa.
# O'z ID ingizni @userinfobot dan oling. Bo'sh qoldirilsa — jimgina o'tkaziladi.
ADMIN_ID="your_admin_id"

# https://aistudio.google.com/apikey dan olinadi
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase → Project Settings → API
SUPABASE_URL="your_supabase_project_url_here"
SUPABASE_KEY="your_supabase_anon_key_here"
