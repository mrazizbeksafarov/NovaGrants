        "text": "01 · Global Flourishing Scholarship (2027)"
      },
      {
        "type": "blockquote",
        "blocks": [
          {
            "type": "paragraph",
            "text": {
              "type": "bold",
              "text": "Birinchi yil kontraktidan £5 000 chegirma"
            }
          }
        ]
      },
      {
        "type": "paragraph",
        "text": "Sussex universitetida magistratura xarajatlarini kamaytirish uchun kontrakt chegirmasi."
      },
      {
        "type": "details",
        "summary": "Dastur shartlari",
        "blocks": [
          {
            "type": "paragraph",
            "text": [
              {
                "type": "bold",
                "text": "Kimlar uchun: "
              },
              "Tegishli magistratura kursiga qabul olgan, Overseas fee statusiga ega nomzodlar. Kontrakti boshqa tashkilot tomonidan to‘liq qoplanadiganlar qatnasha olmaydi."
            ]
          }
        ]
      },
      {
        "type": "footer",
        "text": "Muddat ko'rsatilmagan"
      },
      {
        "type": "buttons",
        "buttons": [
          {
            "text": "Ariza va tafsilotlar",
            "style": "primary",
            "url": "https://www.sussex.ac.uk/study/fees-funding/masters-scholarships/view/1959-Global-Flourishing-Scholarship"
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "anchor",
        "name": "grant-2"
      },
      {
        "type": "heading",
        "size": 3,
        "text": "02 · ETH Student Summer Research Fellowship"
      },
      {
        "type": "paragraph",
        "text": "ETH Zurich yozgi tadqiqot fellowship dasturi. Ushbu kartochka yangi formatni ko‘rsatish uchun berilgan."
      },
      {
        "type": "details",
        "summary": "Dastur shartlari",
        "blocks": [
          {
            "type": "paragraph",
            "text": [
              {
                "type": "bold",
                "text": "Kimlar uchun: "
              },
              "Amaldagi fuqarolik, o‘qish bosqichi va muddat talablarini rasmiy sahifada tekshiring."
            ]
          }
        ]
      },
      {
        "type": "footer",
        "text": "Muddat ko'rsatilmagan"
      },
